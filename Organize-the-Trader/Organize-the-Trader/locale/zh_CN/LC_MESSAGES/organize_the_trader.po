msgid "A search bar and sorting in the trade window."
msgstr "交易窗口中的搜索和排序。"

msgid "Enabled"
msgstr "启用"

msgid "Enable Organize the Trader search controls"
msgstr "开启或关闭整个模组"

msgid "Show entry count"
msgstr "显示条目数"

msgid "Show visible and total entry counts in the search bar"
msgstr "在搜索框旁显示可见条目数和总条目数"

msgid "Show quantity count"
msgstr "显示数量"

msgid "Show visible stack quantity in the search bar"
msgstr "在搜索框旁显示可见堆叠的总数量"

msgid "Show clear button"
msgstr "清除按钮"

msgid "Show the clear button inside the search bar"
msgstr "搜索框内的清除按钮"

msgid "Auto-focus search"
msgstr "自动聚焦搜索框"

msgid "Focus the trader search input automatically when controls are injected"
msgstr "打开交易窗口时自动将光标放入搜索框"

msgid "Search input width"
msgstr "搜索框宽度"

msgid "Desired search input width in pixels"
msgstr "搜索框宽度（像素）"

msgid "Search input height"
msgstr "搜索框高度"

msgid "Desired search input height in pixels"
msgstr "搜索框高度（像素）"

msgid "Sort panel width"
msgstr "排序面板宽度"

msgid "Desired sort panel width in pixels"
msgstr "排序面板宽度（像素）"

msgid "Sort panel height"
msgstr "排序面板高度"

msgid "Desired sort panel height in pixels"
msgstr "排序面板高度（像素）"

msgid "Debug logging"
msgstr "详细日志"

msgid "Write detailed logs to RE_Kenshi_log.txt"
msgstr "将详细日志写入 RE_Kenshi_log.txt"

msgid "Search items..."
msgstr "搜索物品..."

msgid "Sort"
msgstr "排序"

msgid "Default"
msgstr "默认"

msgid "By name"
msgstr "按名称"

msgid "Unit price"
msgstr "单价"

msgid "Stack value"
msgstr "整组价值"

msgid "Unit weight"
msgstr "单件重量"

msgid "Stack weight"
msgstr "整组重量"

msgid "Price / weight"
msgstr "价格/重量"

msgid "Sort list width"
msgstr "排序列表宽度"

msgid "Width of the sort drop-down at the bottom of the trader window, in pixels. 0 - fitted to the window; a set width moves the direction and Arrange buttons to the right"
msgstr "交易窗口底部排序下拉列表的宽度(像素)。0 - 适应窗口;设置宽度后,方向按钮和整理按钮会向右移动"

msgid "Deal"
msgstr "交易"

msgid "Search field width"
msgstr "搜索框宽度"

msgid "Width of the search field at the bottom of the trader window, in pixels"
msgstr "交易窗口底部搜索框的宽度(像素)"

msgid "Deal balance"
msgstr "交易盈亏"

msgid "How much you made in this trader window (green - plus, red - minus), next to the trader's money"
msgstr "在商人的金钱旁显示本次交易窗口的盈亏(绿色为盈,红色为亏)"
